{
  "name": "yoto-bench",
  "version": "1.0.0",
  "description": "A modern, responsive, client-side web application built with Lit custom elements and @lit-labs/router for managing your Yoto Player library directly in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --write 'src/**/*.{ts,css,html}'",
    "test:unit": "wtr",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anitschke/yoto-bench.git"
  },
  "keywords": [
    "yoto",
    "yoto-player",
    "lit",
    "web-components"
  ],
  "author": "Andrew Nitschke",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/anitschke/yoto-bench/issues"
  },
  "homepage": "https://github.com/anitschke/yoto-bench#readme",
  "dependencies": {
    "@lit-labs/router": "^0.1.4",
    "@lit/context": "^1.1.6",
    "lit": "^3.3.3",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "cheerio": "^1.2.0",
    "eslint": "^9.20.0",
    "eslint-plugin-lit": "^2.3.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "~5.7.3",
    "vite": "^8.3.0",
    "vite-plugin-sri": "^0.0.2"
  }
}
